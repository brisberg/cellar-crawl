:: Startup [startup] {"position":"25,0","size":"100,100"}
<!-- Set up Initial Variables -->\
<script>pushEvent('Story', 'Start', '');</script>\
\
<!-- Item locations: "player", a passage name, or "gone". Single source of truth for every item. -->\
<!-- Item IDs are hyphenated; each has an "<id>-item" description passage tagged "item". -->\
(set: $where to (dm:
	"lantern", "player",
	"rusty-key", "player",
	"hammer", "Storeroom",
	"valve-wheel", "Pump Room",
	"sandbag", "Pump Room",
	"heartstone", "Heart Chamber",
))\
\
<!-- Item helpers -->\
<!-- $move also reruns the footer's inventory list so it stays current when items change mid-passage. -->\
(set: $move to (macro: str-type _id, str-type _loc, [(output:)[(set: $where's (_id) to _loc)(rerun: ?footerinv)]]))\
(set: $has to (macro: str-type _id, [(output-data: $where's (_id) is "player")]))\
(set: $carried to (macro: [(output-data: (find: _x where $where's (_x) is "player", ...(dm-names: $where)))]))\
(set: $name to (macro: str-type _id, [(output-data: (str-replaced: "-", " ", _id))]))\
\
<!-- ($useOn: target, outcomes, [fallback]) -->\
<!-- Opens a dialog listing carried items. outcomes maps item ID -> passage to (display:) when that item is chosen. -->\
<!-- Any other item prints the fallback message, or "Nothing happens." Cancel prints nothing. -->\
<!-- Before an outcome passage is displayed, $used_item holds the chosen item ID, so one passage can serve several items. -->\
<!-- Note: a blocking (dialog:) breaks (else:) chains around it, so use separate (if:)s, not (if:)/(else:). -->\
(set: $useOn to (macro: str-type _target, dm-type _outcomes, ...str-type _fallback, [(output:)[\
(set: _items to ($carried:))\
(if: _items's length is 0)[(dialog: "You have nothing to use on " + _target + ".")]\
(if: _items's length > 0)[\
(set: _choice to "Cancel")\
(dialog: bind _choice, "Use what on " + _target + "?", ...(altered: _x via ($name: _x), ..._items), "Cancel")\
(unless: _choice is "Cancel")[\
(set: _id to (find: _x where ($name: _x) is _choice, ..._items)'s 1st)\
(if: _outcomes contains _id)[(set: $used_item to _id)(display: _outcomes's (_id))]\
(else-if: _fallback's length > 0)[(print: _fallback's 1st)]\
(else:)[Nothing happens.]\
]]]]))\
\
(set: $used_item to "")\
\
<!-- ($reveal: id, label, detail) -->\
<!-- Prints a clickable label; clicking it appends the detail and records the id in $inspected. -->\
<!-- Once inspected, it renders label + detail with no link, on every later visit. -->\
(set: $inspected to (a:))\
(set: $reveal to (macro: str-type _id, str-type _label, str-type _detail, [(output:)[\
(if: $inspected contains _id)[(print: _label + _detail)]\
(else:)[(link-reveal: _label)[(set: $inspected to it + (a: _id))(print: _detail)]]\
]]))\
\
<!-- World state -->\
(set: $door_locked to true)\
(set: $wall_intact to true)\
(set: $wheel_stuck to true)\
(set: $cistern_drained to false)\
(set: $wine_door_bolted to true)\
(set: $heart_door_open to false)\
(set: $dial1 to "moon")\
(set: $dial2 to "moon")\
(set: $dial3 to "moon")\
(set: $lantern_lit to false)\
(set: $thud_lvl to 1)\
\
<!-- Collapse timer: starts when the Heartstone is taken. See CollapseTick. -->\
(set: $collapsing to false)\
(set: $collapse_budget to 10)\
(set: $moves_left to $collapse_budget)\
(set: $free_return to false)\
\
(set: $sound_msgs to (a:
	"",
	"You feel slight tremors in the rock beneath your feet.",
	"A faint but deep throbbing sound reaches you through the rock.",
	"The throbbing sound comes from the rock all around you, permeating your thoughts.",
	"*Bu-dum* *Bu-dum*. The walls themselves scream at you with a deafening cacophony.",
))\
(set: $panic_msgs to (a:
	"",
	"The low thudding is faint now.",
	"The beating sound is more distant now. You still feel it in your feet, but can hear your thoughts again.",
	"Panicked thudding echoes and shakes the tunnel behind you.",
	"*Bu-dum-dum* *Bu-dum-dum*. The rising thrumming shakes the walls, which shower you in gravel in protest.",
))
