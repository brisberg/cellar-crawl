:: StoryStylesheet [stylesheet]
/* Dialog buttons ($useOn item lists) wrap instead of overflowing in a single row. */
tw-dialog-links {
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 0.5em;
}
/* Harlowe sets per-button margins inline; gap replaces them. */
tw-dialog-links tw-link {
  margin: 0 !important;
}

/* Harlowe caps dialogs at 50vw, which is too narrow on phones. */
@media (max-width: 600px) {
  tw-dialog {
    max-width: calc(100vw - 32px);
    box-sizing: border-box;
    padding: 1em;
  }
}

/* Collapse meter: show the empty track, keep the label off the border. */
tw-meter {
  box-sizing: border-box;
  border: 1px solid #8b1a1a;
  padding: 0 0.5em;
}

/* Heart Chamber dials: tapped repeatedly and stacked, so give them button-sized targets (>= 40px tall). */
tw-hook[name^="dial"] tw-link {
  display: inline-block;
  min-width: 5em;
  padding: 0.35em 0.75em;
  margin: 0.2em 0;
  border: 1px solid currentColor;
  border-radius: 0.5em;
  text-align: center;
}
